    "import statsmodels.api as sm\n",
    "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
    "\n",
    "def calculate_vif(X: pd.DataFrame):\n",
    "    \"\"\"Return a DataFrame with VIF values for each feature in X\"\"\"\n",
    "    X_with_const = sm.add_constant(X)  # add intercept for statsmodels\n",
    "    vif_data = pd.DataFrame()\n",
    "    vif_data[\"feature\"] = X.columns\n",
    "    vif_data[\"VIF\"] = [\n",
    "        variance_inflation_factor(X_with_const.values, i + 1)  # +1 to skip intercept\n",
    "        for i in range(len(X.columns))\n",
    "    ]\n",
    "    return vif_data\n",
    "\n",
    "# Example\n",
    "vif_df = calculate_vif(X_train.dropna())\n",
    "print(vif_df)"
   ]
