   "source": [
    "params = {\n",
    "    \"objective\": \"regression\",      # or \"binary\"/\"multiclass\" for classification\n",
    "    \"metric\": \"rmse\",               # regression metric\n",
    "    \"boosting_type\": \"gbdt\",        # standard boosting\n",
    "    \"n_estimators\": 500,           # max trees; use early stopping to stop earlier\n",
    "    \"learning_rate\": 0.05,          # smaller = more accurate, slower\n",
    "    \"num_leaves\": 128,              # main complexity parameter (64–256 is typical)\n",
    "    \"max_depth\": -1,                # -1 = no limit, but depth is controlled by num_leaves\n",
    "    \"min_data_in_leaf\": 100,        # prevents overfitting on big data\n",
    "    \"feature_fraction\": 0.8,        # random feature subsampling\n",
    "    \"bagging_fraction\": 0.8,        # random row subsampling\n",
    "    \"bagging_freq\": 1,              # apply bagging every iteration\n",
    "    \"lambda_l1\": 0.1,               # L1 regularization\n",
    "    \"lambda_l2\": 0.1,               # L2 regularization\n",
    "    \"verbosity\": -1,\n",
    "    \"n_jobs\": -1,\n",
    "    \"random_state\": 42\n",
    "}\n",
    "\n",
    "model2 = lgb.LGBMRegressor(**params)\n",
    "model2.fit(X_train, y_train, eval_set=[(X_test, y_test)])"
