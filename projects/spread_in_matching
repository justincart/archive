    "import lightgbm as lgb\n",
    "\n",
    "# From Random Search CV: \n",
    "# Best Params: {'subsample': 1.0, 'reg_lambda': 0.1, 'reg_alpha': 0, 'num_leaves': 31, \n",
    "# 'n_estimators': 200, 'min_child_samples': 50, 'max_depth': -1, \n",
    "# 'learning_rate': 0.01, 'colsample_bytree': 0.8}\n",
    "params = {\n",
    "    \"objective\": \"regression\",   # or \"binary\"/\"multiclass\" for classification\n",
    "    \"metric\": \"rmse\",            # or \"mae\", \"binary_logloss\", etc.\n",
    "    \"boosting_type\": \"gbdt\",     # standard boosting\n",
    "    \"n_estimators\": 500,         # number of boosting rounds\n",
    "    \"learning_rate\": 0.05,       # lower → better accuracy, slower training\n",
    "    \"num_leaves\": 64,            # controls complexity (like max_depth)\n",
    "    \"max_depth\": -1,             # -1 means no limit, but usually tune\n",
    "    \"min_data_in_leaf\": 50,      # prevents overfitting on big data\n",
    "    \"feature_fraction\": 0.8,     # subsample features per split\n",
    "    \"bagging_fraction\": 0.8,     # subsample rows per tree\n",
    "    \"bagging_freq\": 1,\n",
    "    \"n_jobs\": -1,\n",
    "    \"random_state\": 42\n",
    "}\n",
    "\n",
    "model = lgb.LGBMRegressor(**params)\n",
    "model.fit(X_train, y_train, eval_set=[(X_test, y_test)])"
   ]
